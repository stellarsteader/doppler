# Copy to .env. Docker Compose reads it automatically. From source:
#   uv run uvicorn stt.main:app --env-file .env
# The Linux service uses /etc/doppler.env instead (created by deploy/setup.sh).

# Whisper model. large-v3-turbo is the best speed/quality trade-off on CPU.
STT_MODEL=large-v3-turbo
# Small model used only to detect the language (much faster than detecting with the main model).
# `base` is quicker still but hears Norwegian as Russian.
STT_LANGID_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 0 = every core. On Apple Silicon use the performance-core count instead:
# the efficiency cores slow it down (M-series 14-core MacBook Pro: 8 was ~2x faster than 14).
STT_CPU_THREADS=0
# 5 = more accurate, 1 = faster.
STT_BEAM_SIZE=5

# Auto-detect is limited to these languages (stops short clips being mistaken for Japanese etc.).
STT_LANGUAGES=en,ko,no

# Comma-separated device:token pairs. Leave empty to disable auth (local testing only).
STT_TOKENS=

STT_DB_PATH=data/transcripts.db
STT_MAX_UPLOAD_MB=50
